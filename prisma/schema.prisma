// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}


//! <----------------------------------------<< Enums  >>---------------------------------------->

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
  WEB
  OTHER
}

enum Roles {
  USER
  ADMIN
  OWNER
  SELLER
  MODERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum VerifyCodeType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum NotificationType {
  ORDER
  PAYMENT
  SHIPPING
  DELIVERY
  MARKETING
  PROMOTION
  SYSTEM
  SECURITY
  REMINDER
  WELCOME
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED  
  SCHEDULED
  DRAFT
}

enum AuthProvider {
  GOOGLE
  APPLE
  GITHUB
  LOCAL
}

enum TicketStatus {
  OPEN       
  IN_PROGRESS
  PENDING   
  RESOLVED   
  CLOSED     
  REOPENED  
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  GENERAL   
  TECHNICAL  
  BILLING    
  SUPPORT  
  FEATURE     
  BUG       
  COMPLAINT   
  OTHER     
}

enum CommentStatus {
  PENDING
  APPROVED 
  REJECTED 
  FLAGGED 
  DELETED 
  HIDDEN 
}

enum CartStatus {
  ACTIVE
  CHECKOUT
  ABANDONED
  MERGED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE  
  FIXED    
  FREE_SHIPPING 
}

enum DiscountScope {
  ALL_PRODUCTS       
  SPECIFIC_PRODUCTS  
  SPECIFIC_CATEGORIES
  FIRST_ORDER        
  USER_SPECIFIC      
}

enum DiscountStatus {
  DRAFT  
  ACTIVE  
  EXPIRED 
  DISABLED 
  EXHAUSTED 
}

enum DiscountTargetType {
  PRODUCT
  CATEGORY
  USER
}

enum DiscountUsageStatus {
  USED
  REFUNDED
  CANCELLED
}

//! <----------------------------------------<< Moldes >>---------------------------------------->

//? <----------------------- User ----------------------->
model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  firstName           String
  lastName            String
  userName            String?  @unique
  password            String?

  isVerified           Boolean @default(false)
  provider             AuthProvider @default(LOCAL)
  googleId             String? @unique @map("google_id")
  githubId             String? @unique @map("github_id")
  appleId              String? @unique @map("apple_id")

  avatar               String?
  bio                  String?

  userStatus           UserStatus @default(ACTIVE) @map("user_status")

  deletedAt            DateTime? @map("deleted_at")
  deletedBy            String?   @map("deleted_by")
  deleteReason         String?   @map("delete_reason")
  isDeleted            Boolean   @default(false) @map("is_deleted")

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  sellerInfo           Json?
  sellerVerified       Boolean @default(false)

  lastLoginAt          DateTime?

  refreshTokens        RefreshToken[]
  roles                UserRole[]
  images               UserImage[]
  verifyCodes          verifyCode[]
  notifications        Notification[]
  userNotifications    UserNotification[]
  products             Product[]
  tickets              Ticket[]
  comments             Comment[]
  discountUsage        DiscountUsage[]
  userDiscounts        Discount[] @relation("UserDiscounts")
  cart                 Cart[]
}


//? <----------------------- Refresh Token ----------------------->
model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique @db.Text

  expiresAt   DateTime @map("expires_at") 
  isRevoked   Boolean  @default(false) @map("is_revoked")
  revokedAt   DateTime? @map("revoked_at") 
  revokedReason String? @map("revoked_reason") 
  
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  deviceInfo  String?  @map("device_info") @db.VarChar(255)
  deviceType  DeviceType? @map("device_type") 
  deviceId    String?  @map("device_id") 
  
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text 
  
  location    Json?
  
  lastUsedAt  DateTime? @map("last_used_at")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@index([isRevoked])
  @@map("refresh_tokens")
}

//? <----------------------- User Image ----------------------->
model UserImage {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  url         String 
  publicId    String   @map("public_id") 
  
  isActive    Boolean  @default(true) @map("is_active")
  
  title       String? 
  size        Int?   
  mimeType    String?  @map("mime_type")
  width       Int?
  height      Int?
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@index([userId])
  @@map("user_images")
}

//? <----------------------- Verify Code ----------------------->
model verifyCode {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  email     String
  code      String 
  expiresAt DateTime @map("expires_at")
  
  isUsed    Boolean  @default(false) @map("is_used")
  usedAt    DateTime? @map("used_at")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  type       VerifyCodeType
  
  @@index([userId])
  @@index([code])
  @@index([expiresAt])
  @@map("verify_code")
}

//? <----------------------- Notification ----------------------->
model Notification {
  id       String    @id @default(cuid())
  userId   String    @map("user_id")
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  message  String
  content  Json?

  type      NotificationType
  priority  NotificationPriority

  status    NotificationStatus

  isBroadcast    Boolean @default(false)
  targetAudience String?

  scheduledFor DateTime?
  sentAt       DateTime?
  deliveredAt  DateTime?

  icon          String? 
  link          String?

  deletedAt     DateTime?
  isActive      Boolean @default(true)
  
  metadata      Json?  

  orderId   String?    @map("order_id")
  // order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?    @map("product_id")
  // product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  userNotifications UserNotification[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

//? <----------------------- User Notification ----------------------->
model UserNotification {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String 
  notification    Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  isRead        Boolean    @default(false)
  readAt        DateTime?
  isDismissed   Boolean  @default(false) @map("is_dismissed")
  dismissedAt   DateTime? @map("dismissed_at")
  deliveredAt   DateTime @default(now())

  @@index([userId, notificationId])
  @@index([userId, isRead])
}

//? <----------------------- Permission Group ----------------------->
model PermissionGroup {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  icon        String? 
  permissions Permission[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("permission_groups")
}

//? <----------------------- Permission ----------------------->
model Permission {
  id          String      @id @default(cuid())
  name        String      @unique
  resource    String  
  action      String 
  description String?
  isActive    Boolean     @default(true)
  
  groupId     String?     @map("group_id")
  group       PermissionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  
  roles       RolePermission[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([resource, action])
  @@map("permissions")
}

//? <----------------------- Role ----------------------->
model Role {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  scope       String? 
  isActive    Boolean     @default(true)
  isDefault   Boolean     @default(false)
  
  users       UserRole[]
  permissions RolePermission[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("roles")
}

//? <----------------------- Role Permission ----------------------->
model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  priority     Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

//? <----------------------- User Role ----------------------->
model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  scope     String?
  grantedBy String?  @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean  @default(true)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

//? <----------------------- Product ----------------------->
model Product {
  id          String    @id @default(cuid())
  title       String    @db.VarChar(128)
  description String    @db.VarChar(256)
  price       Int       @default(0)
  stock       Int       @default(0)
  brand       String    @db.VarChar(64)
  model       String    @db.VarChar(64)
  isActive    Boolean   @default(true)
  discount    Int
  rating      Float
  deletedAt   DateTime? @map("deleted_at")
  isDeleted   Boolean   @default(false) @map("is_deleted")
 
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  categories  ProductCategory[]
  images      ProductImage[]
  comments    Comment[]
  // bookmarks    Bookmark[]
  // comments     Comment[]
  // orderItems   OrderItem[]
  cartItems   CartItem[]
  discountProduct   DiscountProduct[]
  // savedCardItems SavedCartItem[]

  @@map("products")
}

//? <----------------------- Product Image ----------------------->
model ProductImage {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  url         String 
  publicId    String   @map("public_id") 
  
  isActive    Boolean  @default(true) @map("is_active")
  
  title       String? 
  size        Int?   
  mimeType    String?  @map("mime_type")
  width       Int?
  height      Int?
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@index([productId])
  @@map("product_images")
}

//? <----------------------- Product Category ----------------------->
model ProductCategory {
  productId   String   @map("product_id")
  categoryId  String   @map("category_id")
  
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())

  @@id([productId, categoryId])
  @@map("product_categories")
}

//? <----------------------- Category ----------------------->
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  isActive    Boolean  @default(true)
  deletedAt   DateTime? @map("deleted_at")
  isDeleted   Boolean   @default(false) @map("is_deleted")

  products            ProductCategory[]
  categoryDiscount    DiscountCategory[]

  @@map("categories")
}


//? <----------------------- Ticket ----------------------->
model Ticket {
  id          String   @id @default(cuid())
  title       String  
  description String 
  category    TicketCategory @default(GENERAL)
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)

  deletedAt   DateTime? @map("deleted_at")
  isDeleted   Boolean   @default(false) @map("is_deleted")

  attachments Json?    

  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // assignedToId String? @map("assigned_to_id")
  // assignedTo   User?   @relation("AssignedTickets", fields: [assignedToId], references: [id])
  
  replyToId   String?  @map("reply_to_id")
  replyTo     Ticket?  @relation("ticketReplies", fields: [replyToId], references: [id])
  replies     Ticket[] @relation("ticketReplies")

  replyCount  Int      @default(0) @map("reply_count")
  rating      Int? 
  tags        String[] @default([]) 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime? @map("resolved_at")
  closedAt    DateTime? @map("closed_at")
  lastRepliedAt DateTime? @map("last_replied_at")

  @@index([userId])
  // @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
  @@index([replyToId])
  @@map("tickets")
}

//? <----------------------- Comment ----------------------->
model Comment {
  id         String    @id @default(cuid())
  content    String    @db.Text
  rating     Int       @default(0)
  
  status     CommentStatus @default(PENDING)
  isDeleted  Boolean   @default(false) @map("is_deleted")
  deletedAt  DateTime? @map("deleted_at")

  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  productId  String    @map("product_id")
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  parentId   String?   @map("parent_id")
  parent     Comment?  @relation("commentReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation("commentReplies")

  likesCount    Int       @default(0) @map("likes_count")
  dislikesCount Int       @default(0) @map("dislikes_count")
  replyCount    Int       @default(0) @map("reply_count")
  
  isReported  Boolean  @default(false) @map("is_reported")
  reportedAt  DateTime? @map("reported_at")
  reportReason String? @map("report_reason") @db.Text

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  approvedAt DateTime? @map("approved_at")
  editedAt   DateTime? @map("edited_at")

  @@index([userId])
  @@index([productId])
  @@index([parentId])
  @@index([status])
  @@index([isDeleted])
  @@index([createdAt])
  @@index([rating])
  @@index([productId, status])
  @@map("comments")
}

//? <----------------------- Card ----------------------->
model Cart {
  id          String      @id @default(cuid())
  
  userId      String?     @map("user_id")
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status      CartStatus  @default(ACTIVE)
  
  subtotal    Decimal     @default(0) @db.Decimal(10, 2)
  discount    Decimal     @default(0) @db.Decimal(10, 2)
  total       Decimal     @default(0) @db.Decimal(10, 2)
  
  guestToken  String?     @unique @map("guest_token") 

  discountId  String?     @map("discount_id")
  discountRef Discount?   @relation(fields: [discountId], references: [id])
  
  itemCount   Int         @default(0) @map("item_count")
  note        String?     @db.Text
  
  expiresAt   DateTime?   @map("expires_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  
  items       CartItem[]
  
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("carts")
}

//? <----------------------- Card Item ----------------------->
model CartItem {
  id          String   @id @default(cuid())
  
  cartId      String   @map("cart_id")
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // variantId   String?  @map("variant_id") 
  
  quantity    Int      @default(1)
  price       Decimal  @db.Decimal(10, 2) 
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2) 
  
  selected    Boolean  @default(true)
  
  productSnapshot Json?
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

//? <----------------------- Discount -----------------------> 
model Discount {
  id          String   @id @default(cuid())
  
  code        String   @unique
  title       String
  description String?  @db.Text
  
  type        DiscountType  @default(PERCENTAGE)
  scope       DiscountScope @default(ALL_PRODUCTS)
  
  value       Decimal  @db.Decimal(10, 2)
  maxAmount   Decimal? @db.Decimal(10, 2) @map("max_amount")
  minOrderAmount Decimal? @db.Decimal(10, 2) @map("min_order_amount")
  
  usageLimit  Int      @default(1) @map("usage_limit")
  usedCount   Int      @default(0) @map("used_count")
  perUserLimit Int     @default(1) @map("per_user_limit")
  
  startsAt    DateTime @map("starts_at")
  expiresAt   DateTime @map("expires_at")
  
  status      DiscountStatus @default(ACTIVE)
  
  targetType  DiscountTargetType? @map("target_type")
  
  isFirstOrder Boolean @default(false) @map("is_first_order")
  
  users       User[]   @relation("UserDiscounts")
  products    DiscountProduct[]
  categories  DiscountCategory[] 
  
  carts       Cart[]
  // orders      Order[]
  usages      DiscountUsage[]
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@index([code])
  @@index([status])
  @@index([startsAt])
  @@index([expiresAt])
  @@index([isFirstOrder])
  @@map("discounts")
}

//? <----------------------- Discount Product -----------------------> 
model DiscountProduct {
  discountId  String   @map("discount_id")
  discount    Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@id([discountId, productId])
  @@map("discount_products")
}

//? <----------------------- Discount Category -----------------------> 
model DiscountCategory {
  discountId  String   @map("discount_id")
  discount    Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  
  categoryId  String   @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@id([discountId, categoryId])
  @@map("discount_categories")
}

model DiscountUsage {
  id          String   @id @default(cuid())
  
  discountId  String   @map("discount_id")
  discount    Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // orderId     String?  @map("order_id")
  // order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  discountAmount Decimal @db.Decimal(10, 2) @map("discount_amount")
  
  status      DiscountUsageStatus @default(USED)
  
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  
  usedAt      DateTime @default(now()) @map("used_at")
  
  @@index([discountId])
  @@index([userId])
  // @@index([orderId])
  @@map("discount_usages")
}