// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}


//! <----------------------------------------<< Enums  >>---------------------------------------->

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
  WEB
  OTHER
}

enum Roles {
  USER
  ADMIN
  OWNER
  SELLER
  MODERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum VerifyCodeType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum NotificationType {
  ORDER
  PAYMENT
  SHIPPING
  DELIVERY
  MARKETING
  PROMOTION
  SYSTEM
  SECURITY
  REMINDER
  WELCOME
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED  
}

//! <----------------------------------------<< Moldes >>---------------------------------------->

//? <----------------------- User ----------------------->
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String
  lastName  String
  userName  String?  @unique
  password  String
  avatar    String?
  bio       String?

  userStatus UserStatus @default(ACTIVE) @map("user_status")

  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")
  deleteReason String?   @map("delete_reason")
  isDeleted    Boolean   @default(false) @map("is_deleted")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerInfo  Json?
  sellerVerified Boolean @default(false)

  lastLoginAt   DateTime?

  refreshTokens    RefreshToken[]
  roles    UserRole[]
  images           UserImage[]
  verifyCodes      verifyCode[]
  notifications    Notification[]
  userNotifications    UserNotification[]
}


//? <----------------------- Refresh Token ----------------------->
model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique @db.Text

  expiresAt   DateTime @map("expires_at") 
  isRevoked   Boolean  @default(false) @map("is_revoked")
  revokedAt   DateTime? @map("revoked_at") 
  revokedReason String? @map("revoked_reason") 
  
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  deviceInfo  String?  @map("device_info") @db.VarChar(255)
  deviceType  DeviceType? @map("device_type") 
  deviceId    String?  @map("device_id") 
  
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text 
  
  location    Json?
  
  lastUsedAt  DateTime? @map("last_used_at")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@index([isRevoked])
  @@map("refresh_tokens")
}

//? <----------------------- User Image ----------------------->
model UserImage {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  url         String 
  publicId    String   @map("public_id") 
  
  isActive    Boolean  @default(true) @map("is_active")
  
  title       String? 
  size        Int?   
  mimeType    String?  @map("mime_type")
  width       Int?
  height      Int?
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@index([userId])
  @@map("user_images")
}

//? <----------------------- Verify Code ----------------------->
model verifyCode {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  email     String
  code      String 
  expiresAt DateTime @map("expires_at")
  
  isUsed    Boolean  @default(false) @map("is_used")
  usedAt    DateTime? @map("used_at")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  type       VerifyCodeType
  
  @@index([userId])
  @@index([code])
  @@index([expiresAt])
  @@map("verify_code")
}

//? <----------------------- Notification ----------------------->
model Notification {
  id       String    @id @default(cuid())
  userId   String    @map("user_id")
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  message  String
  content  Json?

  type      NotificationType
  priority  NotificationPriority

  status    NotificationStatus

  isBroadcast    Boolean @default(false)
  targetAudience String?

  scheduledFor DateTime?
  sentAt       DateTime?
  deliveredAt  DateTime?

  icon          String? 
  link          String?
  
  metadata      Json?  

  orderId   String?    @map("order_id")
  // order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?    @map("product_id")
  // product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  userNotifications UserNotification[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

//? <----------------------- User Notification ----------------------->
model UserNotification {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String 
  notification    Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  isRead        Boolean    @default(false)
  readAt        DateTime?
  isDismissedAt DateTime?
  deliveredAt   DateTime @default(now())

  @@index([userId, notificationId])
  @@index([userId, isRead])
}

//? <----------------------- Permission Group ----------------------->
model PermissionGroup {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  icon        String? 
  permissions Permission[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("permission_groups")
}

//? <----------------------- Permission ----------------------->
model Permission {
  id          String      @id @default(cuid())
  name        String      @unique
  resource    String  
  action      String 
  description String?
  isActive    Boolean     @default(true)
  
  groupId     String?     @map("group_id")
  group       PermissionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  
  roles       RolePermission[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([resource, action])
  @@map("permissions")
}

//? <----------------------- Role ----------------------->
model Role {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  scope       String? 
  isActive    Boolean     @default(true)
  isDefault   Boolean     @default(false)
  
  users       UserRole[]
  permissions RolePermission[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("roles")
}

//? <----------------------- Role Permission ----------------------->
model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  priority     Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

//? <----------------------- User Role ----------------------->
model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  scope     String?
  grantedBy String?  @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean  @default(true)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}